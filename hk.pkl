amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"

local linters = new Mapping {
    ["ruff"] = Builtins.ruff
    ["ruff_format"] = Builtins.ruff_format
    ["ty"] {
        glob = "*.py"
        check = "uv check"
        depends = List("ruff_format")
    }
    ["pytest"] {
        glob = List("*.py", "config.toml", "tests/fixtures/*")
        check = "uv run pytest -q"
        depends = List("ty")
    }
}

steps = linters

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
}
